# Next.js Port Environment (optional override)
PORT=3000

# Database Configuration (for Phase 2 PostgreSQL integration)ṭ
# Connection details to AWS RDS or local PostgreSQL container
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/rscoe_grievance?schema=public"

# Auth secrets for security tokens (used in server actions / API routes later)
JWT_SECRET="generate_a_secure_token_secret_for_production"
NEXTAUTH_SECRET="another_secure_hash_for_session_token_cookies"

# Next Public variables (accessible in browser client)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COLLEGE_NAME="JSPM's Rajarshi Shahu College of Engineering (RSCOE)"
NEXT_PUBLIC_INSTITUTION_LOCATION="Tathawade, Pune"

# ── Email / SMTP Configuration ───────────────────────────────────────────────
# Leave SMTP_HOST blank (or unset) to use Ethereal fake SMTP for local testing.
# The server will auto-create a test account and log preview URLs to the console.
# To use real SMTP (e.g. Gmail, SendGrid, Mailgun), fill in all values below.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASS=your-app-password          # Use an App Password, not your main password
#   EMAIL_FROM="RSCOE Portal <your.address@gmail.com>"
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="RSCOE Grievance Portal <noreply@jspm.edu.in>"
