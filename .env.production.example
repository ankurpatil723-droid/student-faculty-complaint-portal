# Production Environment Variable Template (AWS ECS Fargate & AWS Secrets Manager)

# Application Environment
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
APP_NAME="RSCOE Grievance Redressal Portal"
APP_URL=https://grievance.jspm.edu.in

# Security & Authentication Secrets (Store in AWS Secrets Manager)
JWT_SECRET=AWS_SECRETS_MANAGER_JWT_SECRET_KEY_PLACEHOLDER
SESSION_SECRET=AWS_SECRETS_MANAGER_SESSION_SECRET_KEY_PLACEHOLDER

# PostgreSQL Database Connection String (AWS RDS PostgreSQL Multi-AZ)
DATABASE_URL=postgresql://rscoe_db_admin:SECRETS_MANAGER_DB_PASSWORD@rscoe-grievance-db.c123456789.ap-south-1.rds.amazonaws.com:5432/rscoe_grievance_prod?sslmode=require

# AWS Resource Configuration
AWS_REGION=ap-south-1
S3_BUCKET_NAME=rscoe-grievance-attachments-prod
S3_PRESIGNED_URL_EXPIRES_SEC=900

# CloudWatch Centralized Logging
ENABLE_CLOUDWATCH_LOGS=true
LOG_LEVEL=info

# AI Module Configuration
AI_MODEL_NAME="RSCOE-Grievance-AI-v1.4"
AI_CONFIDENCE_THRESHOLD=0.75
